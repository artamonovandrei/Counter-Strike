# path: infra/Caddyfile
#
# Serves the built client and proxies the API and WebSocket to the backend.
#
# With DOMAIN set to a real hostname, Caddy obtains and renews a certificate over ACME
# with no further configuration. With DOMAIN empty it falls back to plain HTTP on :80,
# which is what you want for local testing and IP-only boxes — requesting a certificate
# for an IP address would just fail the challenge in a loop.

{
	admin off
	email {$ACME_EMAIL}
	# Caddy's default log is noisy at this scale; keep errors only.
	log {
		output stderr
		level ERROR
	}
}

{$DOMAIN::80} {
	encode zstd gzip

	# ── API and WebSocket ─────────────────────────────────────────────────────
	# Socket.IO starts on HTTP long-polling and upgrades; both paths must reach the same
	# upstream, and the upgrade headers must survive. Caddy handles that automatically for
	# reverse_proxy, which is the main reason to prefer it over hand-rolled nginx here.
	handle /socket.io/* {
		reverse_proxy backend:8000 {
			# Long-lived connections: don't let the proxy time them out mid-match.
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	# ── static client ─────────────────────────────────────────────────────────
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server

		# Hashed asset filenames can be cached forever; index.html must not be, or players
		# keep running an old client against a new protocol version.
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		@html path / /index.html
		header @html Cache-Control "no-cache"

		header {
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			X-Frame-Options SAMEORIGIN
			-Server
		}
	}

	respond /healthz 200 {
		body "ok"
	}
}
