# path: .env.example
# Copy to .env and edit. Everything has a working default for local development.

# ─── Public hostname ───────────────────────────────────────────────────────────
# Leave DOMAIN empty for plain HTTP on port 80 (local / IP-only deployments).
# Set it to a real hostname whose A record points at this machine and Caddy will
# obtain and renew a TLS certificate automatically.
DOMAIN=
ACME_EMAIL=

# ─── Backend ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Comma-separated list of allowed browser origins. "*" is fine behind the bundled
# reverse proxy (same-origin), but pin it if the frontend is hosted elsewhere.
CORS_ORIGINS=*

# ─── Simulation ────────────────────────────────────────────────────────────────
TICK_HZ=60            # authoritative physics steps per second
SNAPSHOT_HZ=30        # world states sent to each client per second
MAP_NAME=alley

# ─── Rooms / matchmaking ───────────────────────────────────────────────────────
ROOM_MAX_PLAYERS=10   # human slots per room
ROOM_MAX_ROOMS=8      # hard cap; further joins are rejected with a friendly error
BOTS_PER_TEAM=5       # bots are added/removed to keep teams at this size
BOT_DIFFICULTY=normal # easy | normal | hard | expert
BOT_LOGIC_HZ=10       # AI think rate (physics always runs at TICK_HZ)
BOT_FILL=true         # backfill empty slots with bots

# ─── Round rules (Team Deathmatch) ─────────────────────────────────────────────
ROUND_SECONDS=360
SCORE_LIMIT=50
WARMUP_SECONDS=5
INTERMISSION_SECONDS=10
RESPAWN_SECONDS=3

# ─── Netcode ───────────────────────────────────────────────────────────────────
LAGCOMP_MAX_MS=250    # ceiling on how far back a shot may be rewound
INTERP_DELAY_MS=100   # client render delay; must be >= 1000/SNAPSHOT_HZ
MAX_INPUTS_PER_TICK=8 # surplus inputs from a flooding client are dropped

# ─── Optional Redis (only needed for >1 backend process) ───────────────────────
# REDIS_URL=redis://redis:6379/0
REDIS_URL=
