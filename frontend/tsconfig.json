{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,

    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../shared/*"]
    },
    "types": ["vite/client", "node"]
  },
  "include": ["src", "tools", "../shared", "vite.config.ts"],
  // Excluded because it imports @napi-rs/canvas, which is an on-demand tool dependency
  // rather than something every contributor should have to install. See the header of
  // that file for how to run it.
  "exclude": ["tools/texture-luminance.ts"]
}
