# path: infra/Caddyfile
#
# Serves the built client and proxies the API and WebSocket to the backend.
#
# With DOMAIN set to a real hostname, Caddy obtains and renews a certificate over ACME
# with no further configuration. With DOMAIN empty it falls back to plain HTTP on :80,
# which is what you want for local testing and IP-only boxes — requesting a certificate
# for an IP address would just fail the challenge in a loop.

{
	admin off
	# Default email so Caddy starts even when ACME_EMAIL is unset (IP / local HTTP).
	email {$ACME_EMAIL:artamonovandrei88@gmail.com}
	log {
		output stderr
		level ERROR
	}
}

{$DOMAIN::80} {
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	handle /socket.io/* {
		reverse_proxy backend:8000 {
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server

		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		@html path / /index.html
		header @html Cache-Control "no-cache"

		header {
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			X-Frame-Options SAMEORIGIN
			-Server
		}
	}
}
