{
  "name": "webstrike-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WebStrike browser client — Three.js renderer, prediction, HUD.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"../shared/**/*.ts\" index.html",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"../shared/**/*.ts\"",
    "parity": "python3 ../scripts/check-parity.py"
  },
  "dependencies": {
    "socket.io-client": "4.8.3",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "@types/three": "0.185.3",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
